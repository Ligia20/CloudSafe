generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recent_Logs {
  log_id         String       @id(map: "Recent-Logs_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset          String?
  source_ip      String?
  event          String?
  severity       String?
  action         String?
  log_time       DateTime?    @db.Timestamp(6)
  userId         String       @db.Uuid
  category       String?
  rawData        Json?
  riskLevel      String?
  riskScore      Int?
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("Recent_Logs")
}

model Recent_Alert_ {
  alert_id       String          @id(map: "Recent-Alert _pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  severity       String?
  alert_name_    String?         @map("alert_name ")
  asset          String?
  alert_time     DateTime?       @db.Timestamp(6)
  status         String?
  userId         String          @db.Uuid
  organizationId String          @db.Uuid
  history        Alert_History[]
  organization   Organization    @relation(fields: [organizationId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("Recent-Alert")
}

model Asset {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  type            String
  ipAddress       String
  status          String    @default("Pending")
  hostname        String?
  enrollmentToken String    @unique
  lastSeen        DateTime?
  os              String?
  cpuCount        Int?
  totalMemory     BigInt?
  agentVersion    String?
  lastInventory   DateTime?
  createdAt       DateTime  @default(now())
  userId          String    @db.Uuid
  organizationId  String    @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  events        Event[]
  statusHistory Asset_Status_History[]

  @@index([userId])
  @@index([organizationId])
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  username       String          @unique
  password       String
  organizationId String          @db.Uuid
  alertHistory   Alert_History[]
  assets         Asset[]
  alerts         Recent_Alert_[]
  logs           Recent_Logs[]
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@map("User")
}

model Organization {
  id     String          @id @default(uuid()) @db.Uuid
  name   String
  assets Asset[]
  events Event[]
  alerts Recent_Alert_[]
  logs   Recent_Logs[]
  users  User[]

  @@map("Org")
}

model Event {
  id             String   @id @default(uuid()) @db.Uuid
  assetId        String   @db.Uuid
  organizationId String   @db.Uuid
  sourceIp       String?
  eventType      String
  message        String
  severity       String
  metadata       Json?
  timestamp      DateTime @default(now())

  asset        Asset        @relation(fields: [assetId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([timestamp])
  @@index([severity])
  @@map("Event")
}

model Alert_History {
  id        String        @id @default(uuid()) @db.Uuid
  alertId   String        @db.Uuid
  userId    String        @db.Uuid
  oldStatus String
  newStatus String
  changedAt DateTime      @default(now())
  alert     Recent_Alert_ @relation(fields: [alertId], references: [alert_id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([userId])
  @@map("Alert-History")
}

model Asset_Status_History {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @db.Uuid
  oldStatus String
  newStatus String
  changedAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
